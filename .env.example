# Required for Gemini LLM (and Node.js query/chunk embeddings)
GEMINI_API_KEY=

# JWT signing secret for Node.js authentication
JWT_SECRET=docmind-dev-secret-change-in-production

# Server port (3000 in AI Studio)
PORT=3000

# Optional: MongoDB connection string (uses in-memory fallback when omitted)
# MONGODB_URI=mongodb://127.0.0.1:27017/docmind_ai

# Optional: Python FastAPI AI Microservice (for external Node + Python split)
# AI_SERVICE_URL=http://localhost:8001
# INTERNAL_API_SECRET=change-me-internal-secret
# QDRANT_PATH=./qdrant_data
# QDRANT_URL=
